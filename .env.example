# Copy this file to .env and replace the placeholder values.
# Never commit .env.

# Used by the db service to create the database on first start
POSTGRES_USER=stocktrail
POSTGRES_PASSWORD=change-me
POSTGRES_DB=stocktrail

# Used by the api service. The user, password and database name must match
# the values above. The host is "db" (the database service) and the port is
# 5432 inside Docker. From your own machine the database is on port 5434.
DATABASE_URL=postgresql+psycopg://stocktrail:change-me@db:5432/stocktrail

# Secret used to sign login tokens. At least 32 characters. Generate one with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=replace-with-the-output-of-the-command-above
# How long a login token stays valid, in minutes
JWT_EXPIRE_MINUTES=30
